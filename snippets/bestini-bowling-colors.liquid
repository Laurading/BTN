{% doc %}
  Renders Bowling & lacet color choices grouped by finish.
  @param {product} product - The current bag.
  @param {array} sibling_products - Related bags.
  @param {string} sibling_color - Current color name.
  @param {string} product_form_id - Product form identifier.
  @param {block} block - Theme editor block.
  @param {string} [block_style] - Block spacing attributes.
  @param {string} [option_font_size] - Label typography class.
  @param {string} [value_font_size] - Value typography class.
{% enddoc %}

{%- if request.locale.iso_code == 'en' -%}
  {%- assign selected_color_key = product.handle | split: '-' | last | prepend: 'bestini.colors.' -%}
  {%- assign sibling_color = selected_color_key | t -%}
{%- endif -%}

<div class="product__block product__siblings bestini-colors block-padding{% if settings.show_lines %} product__block--lines{% endif %}" {{ block_style }} {{ block.shopify_attributes }}>
  <input type="hidden" form="{{ product_form_id }}" name="properties[{{ 'general.siblings.label' | t | escape }}]" value="{{ sibling_color | escape }}">
  <p class="bestini-colors__legend">
    <span class="{{ option_font_size }}">{{ 'general.siblings.label' | t }} :</span>
    <span class="{{ value_font_size }}">{{ sibling_color | escape }}</span>
  </p>

  {%- assign finishes = 'smooth,suede' | split: ',' -%}
  {%- if product.handle contains 'suede' -%}
    {%- assign finishes = 'suede,smooth' | split: ',' -%}
  {%- endif -%}
  {%- for finish in finishes -%}
    {%- capture cards -%}
      {%- for sibling in sibling_products limit: 50 -%}
        {%- liquid
          assign sibling_finish = 'smooth'
          if sibling.handle contains 'suede'
            assign sibling_finish = 'suede'
          endif
          if sibling_finish != finish
            continue
          endif
          assign color_name = sibling.metafields.theme.sibling_color.value | default: sibling.metafields.theme.sibling_colour.value | default: sibling.metafields.theme.siblings_color.value | default: sibling.metafields.theme.siblings_colour.value | default: sibling.metafields.theme.siblings_colors.value | default: sibling.metafields.theme.siblings_colours.value | default: sibling.title
          if request.locale.iso_code == 'en'
            assign color_key = sibling.handle | split: '-' | last | prepend: 'bestini.colors.'
            assign color_name = color_key | t
          endif
          assign is_preorder = false
          if sibling.tags contains 'preorder' or sibling.tags contains '_preorder' or sibling.metafields.theme.preorder.value
            assign is_preorder = true
          endif
        -%}
        <a class="bestini-color-card{% if sibling.id == product.id %} is-current{% endif %}" href="{{ sibling.url }}#bestini-product-photo"{% if sibling.id == product.id %} aria-current="page"{% endif %}>
          <span class="bestini-color-card__photo">
            {%- if sibling.featured_image -%}
              {{ sibling.featured_image | image_url: width: 300, height: 300, crop: 'center' | image_tag: loading: 'lazy', widths: '100, 200, 300', sizes: '(max-width: 749px) 23vw, 130px', alt: '' }}
            {%- endif -%}
          </span>
          <span class="bestini-color-card__name">{{ color_name | escape }}</span>
          {%- if sibling.available == false -%}
            <span class="bestini-color-card__status">{{ 'products.product.sold_out' | t }}</span>
          {%- elsif is_preorder -%}
            <span class="bestini-color-card__status">{{ 'bestini.color_picker.preorder' | t }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    {%- endcapture -%}
    {%- if cards != blank -%}
      <section class="bestini-colors__group" aria-labelledby="BestiniFinish-{{ section.id }}-{{ block.id }}-{{ finish }}">
        <h3 class="bestini-colors__heading" id="BestiniFinish-{{ section.id }}-{{ block.id }}-{{ finish }}">
          {%- if finish == 'smooth' -%}{{ 'bestini.color_picker.smooth' | t }}{%- else -%}{{ 'bestini.color_picker.suede' | t }}{%- endif -%}
        </h3>
        <div class="bestini-colors__grid">{{ cards }}</div>
      </section>
    {%- endif -%}
  {%- endfor -%}
</div>

{% stylesheet %}
  .bestini-colors__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin: 0 0 18px;
    font-weight: 600;
    text-transform: uppercase;
  }
  .bestini-colors__group + .bestini-colors__group { margin-top: 22px; }
  .bestini-colors__heading {
    margin: 0 0 10px;
    font-size: 15px;
    line-height: 1.4;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .bestini-colors__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 18px 10px;
  }
  .bestini-color-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    color: inherit;
    text-align: center;
    text-decoration: none;
  }
  .bestini-color-card__photo {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 1.5px solid transparent;
    border-radius: 7px;
  }
  .bestini-color-card__photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .bestini-color-card.is-current .bestini-color-card__photo { border-color: #79554b; }
  @media (hover: hover) and (pointer: fine) {
    .bestini-color-card:not(.is-current):hover .bestini-color-card__photo { border-color: #bbaaa4; }
  }
  .bestini-color-card:focus-visible { outline: 2px solid #79554b; outline-offset: 3px; border-radius: 7px; }
  .bestini-color-card__name { font-size: 14px; line-height: 1.3; }
  .bestini-color-card__status { color: #843c28; font-size: 11px; line-height: 1.3; }
  #bestini-product-photo:focus { outline: none; }
  #bestini-product-photo { scroll-margin-top: calc(var(--header-height, 80px) + 12px); }
  @media (min-width: 750px) {
    .bestini-colors__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px 8px; }
    .bestini-colors__group + .bestini-colors__group { margin-top: 16px; }
    .bestini-colors__heading { margin-bottom: 6px; }
    .bestini-color-card__name { font-size: 12px; }
    .bestini-color-card__status { font-size: 10px; }
  }
  @media (max-width: 749px) {
    .bestini-colors__grid { gap: 16px 8px; }
    .bestini-color-card__name { font-size: 12px; }
    .bestini-color-card__status { font-size: 10px; }
  }
{% endstylesheet %}
