<!-- /snippets/product-siblings.liquid -->

{%- liquid
  comment
    Source des produits frères — même ordre que dans snippets/product-grid-item.liquid :
    collection du bloc > metafield theme.sibling_products > collection theme.siblings > repli Bowling
  endcomment
  assign sibs_collection = collections[block.settings.siblings_collection].products

  if sibs_collection == blank
    assign sibs_collection = product.metafields.theme.sibling_products.value | default: collections[product.metafields.theme.siblings.value].products
  endif

  if sibs_collection == blank and product.handle contains 'bowling-lacet'
    assign sibs_collection = collections['sac-bowling-lacet'].products
  endif

  capture sibling_color
    render 'bestini-color-name', product: product
  endcapture
  if sibling_color == blank
    assign sibling_color = block.settings.sibling_color
  endif
-%}

{%- if sibs_collection.size > 0 -%}
  {%- render 'bestini-colors',
    product: product,
    sibling_products: sibs_collection,
    sibling_color: sibling_color,
    product_form_id: product_form_id,
    block: block,
    block_style: block_style,
    option_font_size: block.settings.option_font_size,
    value_font_size: block.settings.value_font_size,
    product_api: product_api
  -%}
{%- elsif request.design_mode -%}
  <div {{ block.shopify_attributes }}></div>
{%- endif -%}
