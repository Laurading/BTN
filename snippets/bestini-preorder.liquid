{% doc %}
  Règle unique de précommande. Affiche "true" si le produit est en précommande, rien sinon.
  À utiliser dans un capture, puis tester le résultat avec « contains 'true' ».
  Précommande uniquement si une date est renseignée dans custom.preorder_date et qu'elle n'est pas passée.
  @param {product} product - Le produit.
{% enddoc %}

{%- liquid
  assign preorder = false
  assign preorder_date = product.metafields.custom.preorder_date.value

  if preorder_date != blank
    assign today = 'now' | date: '%Y-%m-%d'
    if preorder_date >= today
      assign preorder = true
    endif
  endif

  if preorder
    echo 'true'
  endif
-%}
