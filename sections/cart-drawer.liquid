#CartNewsletterDialog#CartNewsletterDialog [class$="-field-container-62a34db0f7b3732a01429b16"],
#CartNewsletterDialog#CartNewsletterDialog [class$="-field-container-62a9d6b641ae6e18923f204d"],
#CartNewsletterDialog#CartNewsletterDialog [class$="-action-container-627932485028ebd8c6660c51"]{padding:6px 0!important;}
#CartNewsletterDialog#CartNewsletterDialog [class$="-field-container-6aa86428edbcef1584f992ad"]{padding:4px 0!important;}
#CartNewsletterDialog#CartNewsletterDialog label{padding:6px 0!important;}
#CartNewsletterDialog#CartNewsletterDialog [class$="-field-container-6aa86428edbcef1584f992ad-label"]{font-size:14px!important;}
#CartNewsletterDialog#CartNewsletterDialog [id^="omnisend-form-"] input:not([type=checkbox]){font-size:16px!important;min-height:44px;padding:10px!important;}
#CartNewsletterDialog#CartNewsletterDialog [class$="-description-container"]{font-size:12px!important;line-height:1.35!important;}
