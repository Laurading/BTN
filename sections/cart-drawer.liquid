<style>#CartNewsletterDialog::backdrop{background:rgba(0,0,0,.45)}#CartNewsletterDialog p{margin:12px 0}</style>
<script>
(function(){
 if(window.__bestiniCartNewsletter)return;
 window.__bestiniCartNewsletter=true;
 var lastOpener;
 function showNewsletterWhenReady(dialog){
   if(dialog.open || dialog.dataset.newsletterPending)return;
   dialog.dataset.newsletterPending='true';
   var observer,timeout;
   function ready(){return !!dialog.querySelector('[id^="omnisend-form-"] input[type="email"], [data-newsletter-result]');}
   function reveal(){
     if(observer)observer.disconnect();clearTimeout(timeout);
     requestAnimationFrame(function(){requestAnimationFrame(function(){
       delete dialog.dataset.newsletterPending;
       if(dialog.isConnected && !dialog.open)dialog.showModal();
     });});
   }
   if(ready()){reveal();return;}
   observer=new MutationObserver(function(){if(ready())reveal();});
   observer.observe(dialog,{childList:true,subtree:true});
   timeout=setTimeout(reveal,15000);
 }

 document.addEventListener('click',function(event){
   var opener=event.target.closest('[data-drawer-newsletter-open]' );
   var dialog=document.getElementById('CartNewsletterDialog');
   if(!dialog)return;
   if(opener){event.preventDefault();lastOpener=opener;var resume=dialog.querySelector('[data-cart-newsletter-checkout]');if(resume)resume.style.display='none';var backToCart=dialog.querySelector('[data-cart-newsletter-return]');if(backToCart)backToCart.style.display='';try{sessionStorage.setItem('bestini-newsletter-origin','sidebar');}catch(e){}showNewsletterWhenReady(dialog);}
   if(event.target.closest('[data-cart-newsletter-checkout]')){event.preventDefault();location.assign({{ routes.root_url | json }} + 'discount/BIENVENUE10?redirect=' + encodeURIComponent('/checkout?discount=BIENVENUE10'));}
   if(event.target.closest('[data-cart-newsletter-close]')){dialog.close();if(lastOpener)lastOpener.focus();}
 });
 var dialog=document.getElementById('CartNewsletterDialog');
 function openRequestedNewsletter(){if(!dialog || dialog.open)return;var fromCheckout=location.hash==='#CartNewsletterDialog';var hasResult=!!dialog.querySelector('[data-newsletter-result]');if(!fromCheckout && !hasResult)return;var showResume=fromCheckout;try{if(hasResult){var origin=sessionStorage.getItem('bestini-newsletter-origin');if(origin)showResume=origin==='checkout';}else{sessionStorage.setItem('bestini-newsletter-origin','checkout');}}catch(e){}var resume=dialog.querySelector('[data-cart-newsletter-checkout]');if(resume)resume.style.display=showResume?'':'none';var backToCart=dialog.querySelector('[data-cart-newsletter-return]');if(backToCart)backToCart.style.display=showResume?'none':'';if(hasResult){var cleanUrl=new URL(location.href);cleanUrl.searchParams.delete('customer_posted');if(cleanUrl.hash==='#CartNewsletterForm')cleanUrl.hash='';history.replaceState(history.state,'',cleanUrl.href);}showNewsletterWhenReady(dialog);}
 openRequestedNewsletter();
 window.addEventListener('hashchange',openRequestedNewsletter);
})();
</script>

