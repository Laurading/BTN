{%- liquid
  assign desktop_height = section.settings.height
  assign mobile_height = section.settings.mobile_height
  assign width = section.settings.width
  assign show_recently_viewed_indicator = settings.show_recently_viewed_indicator
  assign color_scheme = 'color-' | append: section.settings.color_scheme

  assign border_class = ''
  if section.settings.borders
    assign border_class = 'brick--border'
  endif

  assign transparent_header = false
  assign non_image_block_types = 'text, newsletter, reviews, product, collection' | split: ','
  unless non_image_block_types contains section.blocks[0].type and non_image_block_types contains section.blocks[1].type
    assign transparent_header = true
  endunless

  assign selected_color_scheme = section.settings.color_scheme | strip
  assign scheme_bg_color = settings.color_schemes[selected_color_scheme].settings.section_bg
  assign animation_anchor = '#MenuBrickSection--' | append: section.id

  assign show_video_popup = false
  assign show_video_background = false
  assign video_blocks = section.blocks | where: 'type', 'video'
  for block in video_blocks
    if block.settings.video != null
      assign show_video_background = true
    endif

    if block.settings.show_video_popup
      assign show_video_popup = block.settings.show_video_popup
    endif
  endfor
-%}

{%- render 'stylesheet', name: 'custom-content.css' -%}

{%- style -%}
  /* Bloc Grille d'images 3x3 */
  #MenuBrickSection--{{ section.id }} .brick__block--image-grid {
    display: flex;
    align-items: center;
  }
  #MenuBrickSection--{{ section.id }} .image-grid-3x3 {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap, 8px);
    width: 100%;
  }
  #MenuBrickSection--{{ section.id }} .image-grid-3x3__cell {
    display: block;
    aspect-ratio: var(--cell-ratio, 1);
    overflow: hidden;
    background: rgba(0, 0, 0, 0.04);
  }
  #MenuBrickSection--{{ section.id }} .image-grid-3x3__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    #MenuBrickSection--{{ section.id }} a.image-grid-3x3__cell:hover .image-grid-3x3__img {
      transform: scale(1.04);
    }
  }
  @media only screen and (min-width: 750px) {
    #MenuBrickSection--{{ section.id }} .brick__block--span-two {
      grid-column: span 2;
    }
  }

  #MenuBrickSection--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }

  #MenuBrickSection--{{ section.id }} .brick__section--with-menu {
    display: grid;
    grid-template-columns: {{ section.settings.menu_width }}% repeat(2, 1fr);
    align-items: stretch;
  }

  #MenuBrickSection--{{ section.id }} .brick__block__menu {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: {{ section.settings.menu_valign }};
    height: 100%;
    padding: var(--outer, 40px);
    text-align: left;
  }

  #MenuBrickSection--{{ section.id }} .brick__menu {
    width: 100%;
  }

  #MenuBrickSection--{{ section.id }} .brick__menu__title {
    margin-bottom: 16px;
    opacity: 0.6;
  }

  #MenuBrickSection--{{ section.id }} .brick__menu__list,
  #MenuBrickSection--{{ section.id }} .brick__menu__sublist {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #MenuBrickSection--{{ section.id }} .brick__menu__item {
    margin-bottom: {{ section.settings.menu_spacing }}px;
  }

  #MenuBrickSection--{{ section.id }} .navlink--child span:first-of-type::after {
    content: none;
  }

  #MenuBrickSection--{{ section.id }} .navlink--child:hover span:first-of-type {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #MenuBrickSection--{{ section.id }} .brick__menu__summary:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #MenuBrickSection--{{ section.id }} .brick__menu__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    cursor: pointer;
    list-style: none;
  }

  #MenuBrickSection--{{ section.id }} .brick__menu__summary::-webkit-details-marker {
    display: none;
  }

  #MenuBrickSection--{{ section.id }} .brick__menu__summary svg {
    width: 10px;
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  #MenuBrickSection--{{ section.id }} .brick__menu__details[open] .brick__menu__summary svg {
    transform: rotate(180deg);
  }

  #MenuBrickSection--{{ section.id }} .brick__menu__sublist {
    padding: 8px 0 0 12px;
  }

  #MenuBrickSection--{{ section.id }} .brick__menu__subitem {
    margin-bottom: 8px;
  }

  @media screen and (max-width: 749px) {
    #MenuBrickSection--{{ section.id }} .brick__section--with-menu {
      grid-template-columns: 1fr;
    }

    #MenuBrickSection--{{ section.id }} .brick__block__menu {
      padding: var(--inner, 24px);
    }
  }
   .navlink--child { 
    --link: #OOOOOO;
    text-transform: uppercase;
    }
{%- endstyle -%}

{%- if section.settings.dark_mode -%}
  {%- liquid
    assign dark_bg = section.settings.dark_bg
    assign dark_text = section.settings.dark_text
  -%}
  {%- style -%}
    /* Mode sombre appliqué à toute la page contenant cette section */
    body {
      --bg: {{ dark_bg }};
      --text: {{ dark_text }};
      --text-light: {{ dark_text }};
      --link: {{ dark_text }};
      --link-hover: {{ dark_text }};
      --icons: {{ dark_text }};
      --COLOR-MENU-BG: {{ dark_bg }};
      --COLOR-HEADER-LINK: {{ dark_text }};
      --COLOR-HEADER-LINK-HOVER: {{ dark_text }};
      --COLOR-MENU-TRANSPARENT: {{ dark_text }};
      --border-hairline: {{ dark_text | color_modify: 'alpha', 0.2 }};
      background-color: {{ dark_bg }};
      color: {{ dark_text }};
    }

    .header__wrapper,
    .header__desktop,
    .header__mobile,
    .theme__header,
    .toolbar {
      --bg: {{ dark_bg }};
      --text: {{ dark_text }};
      --link: {{ dark_text }};
      --link-hover: {{ dark_text }};
      --icons: {{ dark_text }};
      color: {{ dark_text }};
    }

    .theme__header .icon {
      --icons: {{ dark_text }};
    }

    #MenuBrickSection--{{ section.id }},
    #MenuBrickSection--{{ section.id }} .brick__block,
    #MenuBrickSection--{{ section.id }} .brick__block__text {
      --bg: {{ dark_bg }} !important;
      --text: {{ dark_text }} !important;
      --text-light: {{ dark_text }} !important;
      --link: {{ dark_text }} !important;
      --link-hover: {{ dark_text }} !important;
      color: {{ dark_text }};
    }

    #MenuBrickSection--{{ section.id }} .brick__block--menu,
    #MenuBrickSection--{{ section.id }} .brick__block__menu {
      background-color: {{ dark_bg }};
    }

    /* Logo : bascule sur la version "header transparent" si elle existe */
    .header__logo--has-transparent .logo__img {
      opacity: 0;
    }

    .header__logo--has-transparent .logo__img--transparent {
      opacity: 1;
    }
  {%- endstyle -%}
{%- endif -%}

{%- if section.settings.hide_footer -%}
  {%- style -%}
    /* Masque les sections du groupe pre-footer (frères de [data-site-container])
       et le footer, sur les pages utilisant cette section. */
    [data-site-container] ~ .shopify-section,
    .footer-sections {
      display: none !important;
    }
  {%- endstyle -%}
{%- endif -%}

{%- if show_video_background -%}
  <script src="{{ 'video-background.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if show_video_popup -%}
  <script src="{{ 'load-photoswipe.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'video-popup.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if show_recently_viewed_indicator -%}
  <script src="{{ 'grid-item.js' | asset_url }}" defer></script>
{%- endif -%}

<section
  id="MenuBrickSection--{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="menu-custom-content"
  {% if transparent_header %}
    data-overlay-header
  {% endif %}
  class="section-padding {{ color_scheme }}"
>
  {%- if section.blocks.size > 0 -%}
    <div class="brick__section brick__section--with-menu{% if section.settings.reverse_blocks %} brick__section--reversed-mobile{% endif %}{% if section.settings.gutters %} brick--margin{% endif %} {{ border_class }} {{ width }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign animation_order = 0
          assign bg_color = block.settings.bg_color | default: scheme_bg_color
          assign text_color = block.settings.color
          assign padding_class = ''
          assign color_difference = bg_color | color_difference: scheme_bg_color

          if bg_color != 'rgba(0,0,0,0)' and color_difference > 10
            assign padding_class = ' has-padding'
          endif
        -%}

        {%- capture style -%}
          {%- unless bg_color.alpha == 0.0 or bg_color == blank -%}
            --bg: {{ bg_color }};
          {%- endunless -%}

          {%- unless text_color.alpha == 0.0 or text_color == blank -%}
            --text: {{ text_color }};
            --text-light: {{ text_color | color_mix: bg_color, 70 }};
            --text-dark: {{ text_color | color_saturate: 10 | color_darken: 15 }};
          {%- endunless -%}
        {%- endcapture -%}

        {%- case block.type -%}
          {%- when 'menu' -%}
            <div
              class="brick__block brick__block--menu"
              {% if style != blank %}
                style="{{ style }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="brick__block__text brick__block__menu{{ padding_class }}">
                {%- if block.settings.title != blank -%}
                  {%- assign animation_order = animation_order | plus: 1 -%}
                  <p
                    class="brick__menu__title"
                    data-aos="hero"
                    data-aos-anchor="{{ animation_anchor }}"
                    data-aos-order="{{ animation_order }}"
                  >
                    {{ block.settings.title }}
                  </p>
                {%- endif -%}

                {%- assign menu = linklists[block.settings.menu] -%}

                {%- if menu.links.size > 0 -%}
                  <nav class="brick__menu {{ block.settings.text_font_size }}">
                    <ul class="brick__menu__list">
                      {%- for link in menu.links -%}
                        {%- assign animation_order = animation_order | plus: 1 -%}
                        <li
                          class="brick__menu__item parent{% if link.links.size > 0 %} brick__menu__item--has-children{% endif %}"
                          data-aos="hero"
                          data-aos-anchor="{{ animation_anchor }}"
                          data-aos-order="{{ animation_order }}"
                        >
                          {%- if link.links.size > 0 -%}
                            <details class="brick__menu__details" {% if block.settings.submenus_open %}open{% endif %}>
                              <summary class="brick__menu__summary">
                                <span>{{ link.title }}</span>
                                {%- render 'icon-nav-arrow-down' -%}
                              </summary>

                              <ul class="brick__menu__sublist">
                                {%- for childlink in link.links -%}
                                  <li class="brick__menu__subitem parent">
                                    <a href="{{ childlink.url }}" class="navlink navlink--child"><span>{{ childlink.title }}</span></a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </details>
                          {%- else -%}
                            <a href="{{ link.url }}" class="navlink navlink--child"><span>{{ link.title }}</span></a>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </nav>
                {%- endif -%}
              </div>
            </div>

          {%- when 'image' -%}
            {%- render 'brick-image', block: block, style: style, animation_anchor: animation_anchor -%}

          {%- when 'text' -%}
            {%- render 'brick-text',
              block: block,
              style: style,
              padding_class: padding_class,
              animation_anchor: animation_anchor
            -%}

          {%- when 'newsletter' -%}
            {%- render 'brick-newsletter',
              block: block,
              style: style,
              padding_class: padding_class,
              animation_anchor: animation_anchor
            -%}

          {%- when 'review' -%}
            {%- render 'brick-review',
              block: block,
              style: style,
              padding_class: padding_class,
              animation_anchor: animation_anchor
            -%}

          {%- when 'product' -%}
            {%- liquid
              assign show_product_card = false

              if bg_color.alpha != 0.0 and bg_color != blank
                assign show_product_card = true
              endif
            -%}

            <div
              class="brick__block"
              {% if style != blank %}
                style="{{ style }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="brick__block__text brick__block__text--column{{ padding_class }} text-center">
                {%- if block.settings.title != blank -%}
                  {%- assign animation_order = animation_order | plus: 1 -%}
                  <p
                    class="brick__product__subheading subheading"
                    data-aos="hero"
                    data-aos-anchor="{{ animation_anchor }}"
                    data-aos-order="{{ animation_order }}"
                  >
                    {{ block.settings.title }}
                  </p>
                {%- endif -%}

                {%- assign animation_order = animation_order | plus: 1 -%}
                <div
                  class="brick__product"
                  data-aos="hero"
                  data-aos-anchor="{{ animation_anchor }}"
                  data-aos-order="{{ animation_order }}"
                >
                  {%- assign product = all_products[block.settings.product] -%}
                  {%- if product != blank -%}
                    {%- render 'product-grid-item',
                      product: product,
                      index: forloop.index,
                      show_product_card: show_product_card
                    -%}
                  {%- else -%}
                    {%- render 'onboarding-product-grid-item',
                      index: forloop.index,
                      animation_delay: forloop.index0,
                      show_product_card: show_product_card
                    -%}
                  {%- endif -%}
                </div>
              </div>

              {%- if settings.quickview_enable -%}
                <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
              {%- endif -%}
            </div>

          {%- when 'video' -%}
            <div
              class="brick__block brick__block--video {{ desktop_height }} {{ mobile_height }}"
              {% if style != blank %}
                style="{{ style }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="brick__block__video frame">
                {%- render 'video',
                  section: block,
                  desktop_height: desktop_height,
                  mobile_height: mobile_height,
                  block_element: true
                -%}
              </div>
            </div>
          {%- when 'collection' -%}
            {%- liquid
              assign block_collection = collections[block.settings.collection]
              assign show_product_card = false

              if bg_color.alpha != 0.0 and bg_color != blank
                assign show_product_card = true
              endif
            -%}

            {%- render 'stylesheet', name: 'look.css' -%}

            <div
              class="brick__block brick__block--collection"
              {% if style != blank %}
                style="{{ style }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="brick__block__collection{{ padding_class }}">
                {%- if block.settings.title != blank -%}
                  <p
                    class="look__title text-center subheading"
                    data-aos="hero"
                    data-aos-anchor="{{ animation_anchor }}"
                    data-aos-order="1"
                  >
                    {{ block.settings.title }}
                  </p>
                {%- endif -%}

                <slider-component
                  class="look__slider"
                  data-slider="{{ block.id }}"
                  data-options='{"watchCSS": true, "fade": true, "pageDots": false, "prevNextButtons": true, "adaptiveHeight": false}'
                  data-arrow-position-middle
                >
                  {%- if block_collection != blank -%}
                    {%- if block_collection.products_count > 0 -%}
                      {% assign index = 0 %}

                      {%- for product in block_collection.products -%}
                        {%- liquid
                          if product.tags contains 'hide'
                            continue
                          endif
                        -%}

                        <div
                          class="look__slide look__slide--{{ block.id }}-{{ forloop.index0 }}"
                          data-slide="{{ block.id }}-{{ forloop.index0 }}"
                          {{ block.shopify_attributes }}
                        >
                          {%- render 'product-grid-item',
                            product: product,
                            index: forloop.index,
                            show_product_card: show_product_card
                          -%}
                        </div>

                        {%- liquid
                          assign index = index | plus: 1
                          if index == 5
                            break
                          endif
                        -%}
                      {%- endfor -%}
                    {%- else -%}
                      <div class="no-results">
                        <p>
                          <strong>{{ 'collections.general.no_matches' | t }}</strong>
                        </p>
                      </div>
                    {%- endif -%}
                  {%- else -%}
                    {%- for i in (1..2) -%}
                      <div
                        class="look__slide look__slide--{{ block.id }}"
                        data-slide="{{ block.id }}"
                        {{ block.shopify_attributes }}
                      >
                        {%- liquid
                          assign product_index = forloop.index | plus: 2
                          assign placeholder = 'product-' | append: product_index
                          capture title
                            cycle 'Nomad X Sunglasses', 'Nomad X Hat'
                          endcapture
                          render 'onboarding-product-grid-item', title: title, placeholder: placeholder, index: forloop.index, animation_delay: forloop.index0, show_product_card: show_product_card
                        -%}
                      </div>
                    {%- endfor -%}
                  {%- endif -%}
                </slider-component>
              </div>
            </div>
          {%- when 'image_grid' -%}
            <div
              class="brick__block brick__block--image-grid{% if block.settings.span_two %} brick__block--span-two{% endif %}"
              style="--grid-gap: {{ block.settings.gap }}px; --cell-ratio: {{ block.settings.aspect_ratio }};{{ style }}"
              {{ block.shopify_attributes }}
            >
              <div class="image-grid-3x3">
                {%- for i in (1..9) -%}
                  {%- liquid
                    assign image_key = 'image_' | append: i
                    assign link_key = 'link_' | append: i
                    assign cell_image = block.settings[image_key]
                    assign cell_link = block.settings[link_key]
                  -%}
                  {%- if cell_link != blank -%}
                    <a class="image-grid-3x3__cell" href="{{ cell_link }}">
                  {%- else -%}
                    <div class="image-grid-3x3__cell">
                  {%- endif -%}
                    {%- if cell_image != blank -%}
                      {{ cell_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '200, 300, 450, 600, 900', sizes: '(min-width: 750px) 20vw, 33vw', class: 'image-grid-3x3__img' }}
                    {%- elsif request.design_mode -%}
                      {{ 'image' | placeholder_svg_tag: 'image-grid-3x3__img image-grid-3x3__img--placeholder' }}
                    {%- endif -%}
                  {%- if cell_link != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>

          {%- when 'before-and-after' -%}
            <div
              class="brick__block brick__block--compare {{ desktop_height }} {{ mobile_height }}"
              {% if style != blank %}
                style="{{ style }}"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="brick__block__compare">
                {%- render 'compare-images',
                  image_1: block.settings.image_1,
                  image_2: block.settings.image_2,
                  image_position: block.settings.image_position,
                  animation_anchor: animation_anchor,
                  wrapper: section.settings.width
                -%}
              </div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- render 'no-blocks' -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Menu + contenu",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "Mise en page de la page"
    },
    {
      "type": "checkbox",
      "id": "hide_footer",
      "label": "Masquer le pre-footer et le footer",
      "info": "S'applique à toute la page contenant cette section.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "dark_mode",
      "label": "Mode sombre",
      "info": "Fond foncé et texte clair sur toute la page, header compris.",
      "default": false
    },
    {
      "type": "color",
      "id": "dark_bg",
      "label": "Fond (mode sombre)",
      "default": "#281815"
    },
    {
      "type": "color",
      "id": "dark_text",
      "label": "Texte (mode sombre)",
      "default": "#F0EEEB"
    },
    {
      "type": "header",
      "content": "Colonne menu"
    },
    {
      "type": "range",
      "id": "menu_width",
      "min": 15,
      "max": 40,
      "step": 1,
      "unit": "%",
      "label": "Largeur de la colonne menu",
      "default": 25
    },
    {
      "type": "select",
      "id": "menu_valign",
      "label": "Alignement vertical du menu",
      "default": "flex-start",
      "options": [
        {"value": "flex-start", "label": "Haut"},
        {"value": "center", "label": "Centre"},
        {"value": "flex-end", "label": "Bas"}
      ]
    },
    {
      "type": "range",
      "id": "menu_spacing",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Espacement entre les liens",
      "default": 14
    },
    {
      "type": "header",
      "content": "Général"
    },
    {
      "type": "checkbox",
      "id": "borders",
      "label": "Add borders",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "gutters",
      "label": "Enable gutters",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full-padded",
      "options": [
        {"value": "wrapper--full", "label": "Full width"},
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Normal"}
      ]
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "screen-height-one-half",
      "options": [
        {"value": "image-height", "label": "Image height"},
        {"value": "screen-height-full", "label": "Full screen height"},
        {"value": "screen-height-three-quarters", "label": "3/4 of screen"},
        {"value": "screen-height-two-thirds", "label": "2/3 of screen"},
        {"value": "screen-height-one-half", "label": "1/2 of screen"},
        {"value": "screen-height-one-third", "label": "1/3 of screen"},
        {"value": "seven-fifty-height-hero", "label": "750px"},
        {"value": "sixty-fifty-height-hero", "label": "650px"},
        {"value": "five-fifty-height-hero", "label": "550px"},
        {"value": "four-fifty-height-hero", "label": "450px"}
      ]
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Height",
      "default": "screen-height-one-half--mobile",
      "options": [
        {"value": "image-height--mobile", "label": "Image height"},
        {"value": "screen-height-full--mobile", "label": "Full screen height"},
