    {% if form.posted_successfully? %}
      <p role="status" data-newsletter-result>{{ 'bestini.newsletter.result_html' | t }}</p>
    {% else %}
      {% if form.errors %}<div role="alert" data-newsletter-result>{{ form.errors | default_errors }}</div>{% endif %}
      <label for="CartNewsletterEmail">{{ 'bestini.newsletter.email' | t }}</label>
      <input id="CartNewsletterEmail" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required placeholder="{{ 'bestini.newsletter.placeholder' | t }}" style="width:100%;min-height:48px;font-size:16px;margin:8px 0;border:1px solid #704a41;border-radius:4px;padding:12px;background:#fff;box-sizing:border-box;">
      <p style="font-size:12px;">{{ 'bestini.newsletter.consent' | t }} <a href="{{ routes.root_url }}policies/privacy-policy" style="text-decoration:underline;">{{ 'bestini.newsletter.privacy' | t }}</a>.</p>
      <button type="submit" class="btn btn--primary btn--solid btn--full">{{ 'bestini.newsletter.submit' | t }}</button>
    {% endif %}
  {% endform %}
{% endcomment %}
  <button type="button" data-cart-newsletter-return class="btn btn--primary btn--solid btn--full" style="margin-top:16px;" onclick="event.preventDefault();event.stopPropagation();this.closest('dialog').close();var drawer=document.querySelector('cart-drawer');if(drawer &amp;&amp; typeof drawer.openCartDrawer==='function'){drawer.openCartDrawer();}else{location.assign({{ routes.cart_url | json | escape }});}">{{ 'bestini.newsletter.back' | t }}</button>
  <button type="button" data-cart-newsletter-checkout class="btn btn--primary btn--solid btn--full" style="margin-top:16px;">{{ 'bestini.newsletter.resume' | t }}</button>
</dialog>

