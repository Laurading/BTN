narrow","color_scheme":"","padding_top":100,"padding_bottom":100,"heading_tag":"automatic"}},"section_video_ikQFJB":{"type":"section-video","disabled":true,"settings":{"video":"shopify:\/\/files\/videos\/MicrosoftTeams-video_823795f4-93d4-4faa-a08e-e654cfd9d659.mp4","show_video_popup":false,"video_popup_social":"https:\/\/www.youtube.com\/watch?v=_9VUPq3SxOc","title":"Notre histoire","heading_font_size":"heading-large","text":"<p>Tell your brand's story through images.<\/p>","text_font_size":"body-medium","flex_align":"align--middle-center","link_text":"","link":"","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"desktop_height":"screen-height-three-quarters","mobile_height":"screen-height-three-quarters--mobile","width":"wrapper--full","color_scheme":"","show_text_background":false,"color":"#ffffff","overlay_type":"disabled","padding_top":0,"padding_bottom":0,"heading_tag":"automatic"}},"section_rich_text_Xe4xLf":{"type":"section-rich-text","blocks":{"heading_mxaU9h":{"type":"heading","settings":{"title":"NOTRE HISTOIRE","heading_font_size":"heading-medium","padding_bottom":0,"heading_tag":"automatic"}},"text_X944AC":{"type":"text","settings":{"text":"<p>Best in I. Le meilleur pour soi. Le nom Bestini vient de ce jeu de mots, resté longtemps silencieux, cousu dans une étiquette.<\/p>","text_font_size":"body-medium","padding_bottom":16}}},"block_order":["heading_mxaU9h","text_X944AC"],"settings":{"align_text":"text-left","width":"wrapper","color_scheme":"scheme-1","overlay_type":"disabled","padding_top":40,"padding_bottom":40}},"section_double_7RtgMF":{"type":"section-double","blocks":{"subheading_Ntfj8U":{"type":"subheading","settings":{"subheading":"Un nom sans voix","padding_bottom":16}},"text_mC4R4r":{"type":"text","settings":{"text":"","text_font_size":"body-medium","padding_bottom":16}},"text_bemmc4":{"type":"text","settings":{"text":"<p>En 1994, Bestini n'est qu'un nom cousu à l'intérieur de sacs fabriqués pour d'autres marques, au sein d'une entreprise familiale de maroquinerie. Pas de collection, pas de style propre, un savoir-faire discret transmis d'atelier en atelier.<\/p>","text_font_size":"body-medium","padding_bottom":16}},"text_dT7bnM":{"type":"text","settings":{"text":"<p>Ce savoir-faire s'affine pendant des années, au service d'autres marques : des collections construites, un regard qui se forme, un œil qui apprend à reconnaître une bonne couture d'une couture pressée. Tu l'as peut-être déjà remarqué en choisissant un sac ici plutôt qu'ailleurs, ce genre de détail ne s'invente pas, il s'apprend.<\/p>","text_font_size":"body-medium","padding_bottom":24}}},"block_order":["subheading_Ntfj8U","text_mC4R4r","text_bemmc4","text_dT7bnM"],"settings":{"image_1":"shopify:\/\/shop_images\/FG200054.jpg","image_width":"one-half","text_alignment":"text-left","layout":"","width":"wrapper--full","height":"image-height","mobile_height":"screen-height-two-thirds--mobile","reverse_blocks":false,"color_scheme":"","padding_top":0,"padding_bottom":0,"show_placeholder":true}},"section_double_fNHVny":{"type":"section-double","blocks":{"subheading_XicYFK":{"type":"subheading","settings":{"subheading":"Donner une voix à un nom","padding_bottom":16}},"text_6tY9Pf":{"type":"text","settings":{"text":"<p>Une main finit par lui donner une direction. Chez Bestini, c'est Janie qui relève le défi. L'intention compte davantage que le nom : proposer une marque à la voix entière, une marque franco-chinoise, sans cuir mais avec du caractère.<\/p><p>Cette intention se traduit dans chaque choix : ne doit sacrifier, ni le style, ni la qualité, ni l'accessibilité. Le sans cuir s'impose dans la même logique, l'exigence ne dépend plus des matières animales. Elle se construit par le design, la qualité d'exécution et l'intention. Un sac peut avoir de l'allure sans avoir coûté une vie.<\/p>","text_font_size":"body-medium","padding_bottom":16}}},"block_order":["subheading_XicYFK","text_6tY9Pf"],"settings":{"image_1":"shopify:\/\/shop_images\/Proposition_contenu_instagram_-_Bestini_8.jpg","image_width":"one-half","text_alignment":"text-center","layout":"is-reversed","width":"wrapper--full","height":"image-height","mobile_height":"screen-height-one-third--mobile","reverse_blocks":false,"color_scheme":"","padding_top":0,"padding_bottom":0,"show_placeholder":true}},"section_double_jMbNNn":{"type":"section-double","blocks":{"subheading_9rQtUb":{"type":"subheading","settings":{"subheading":"Une allure qui dure","padding_bottom":16}},"text_mhRVbw":{"type":"text","settings":{"text":"<p>Nos lignes sont inspirées des années 2000, une époque où la mode savait être précise sans être bavarde. Rien de démonstratif, mais toujours un détail qui retient le regard : une bride, une proportion pensée.<\/p><p>Un sac donne de l'assurance. Il signe une silhouette. Nous construisons nos modèles pour accompagner une vie réelle, entre journées pleines et rendez-vous imprévus.<\/p>","text_font_size":"body-medium","padding_bottom":16}},"buttons_qm3T3k":{"type":"buttons","settings":{"button_text":"Choisir, c'est déjà se connaître","button_url":"shopify:\/\/collections\/tous-les-sacs","button_type":"btn--black","button_size":"btn--small","button_style":"btn--text","show_arrow":false,"padding_bottom":14}}},"block_order":["subheading_9rQtUb","text_mhRVbw","buttons_qm3T3k"],"settings":{"image_1":"shopify:\/\/shop_images\/Proposition_contenu_instagram_-_Bestini_9.jpg","image_width":"one-half","text_alignment":"text-left","layout":"","width":"wrapper--full","height":"image-height","mobile_height":"screen-height-one-third--mobile","reverse_blocks":false,"color_scheme":"","padding_top":0,"padding_bottom":0,"show_placeholder":true}},"section_custom_content_tQbDcA":{"type":"section-custom-content","blocks":{"image_XtmWmH":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/FG200273.jpg","title":"","heading_font_size":"heading-large","text":"","text_font_size":"body-medium","flex_align":"align--middle-