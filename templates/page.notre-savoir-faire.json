height":"five-fifty-height-hero","mobile_height":"screen-height-one-half--mobile","color_scheme":"","padding_top":0,"padding_bottom":0}},"section_rich_text_49tcEA":{"type":"section-rich-text","blocks":{"heading_Qifebp":{"type":"heading","disabled":true,"settings":{"title":"Notre savoir-faire","heading_font_size":"heading-large","padding_bottom":16,"heading_tag":"automatic"}},"text_AAaLmP":{"type":"text","settings":{"text":"<p><strong>Le respect du vivant comme exigence.<\/strong><\/p>","text_font_size":"body-medium","padding_bottom":16}},"subheading_aUphCg":{"type":"subheading","settings":{"subheading":"Plus vraie que nature","padding_bottom":16}},"subheading_x6bDpf":{"type":"subheading","settings":{"subheading":"L’énergie des années 90-2000","padding_bottom":16}},"text_iUhGHk":{"type":"text","settings":{"text":"<p><br\/>Les années qui respirent la créativité et une forme de minimalisme.<br\/>Une époque épurée, pleine d’élan et tournée vers un futur lumineux.<br\/>C’est cet esprit d’espoir et de liberté que le studio de création Bestini cherche à insuffler dans chacune de ses pièces.<br\/><br\/><\/p>","text_font_size":"body-medium","padding_bottom":16}},"subheading_bwThBC":{"type":"subheading","settings":{"subheading":"De l'expérience à une direction consciente","padding_bottom":16}},"text_jgWU4F":{"type":"text","settings":{"text":"<p>Notre collection avance doucement, à son rythme.<br\/>Chaque modèle naît d’un temps de recherche, d’essais, de gestes répétés. Des sacs pensés pour durer, pour plaire longtemps.<\/p><p>Fière de nos racines chinoises, notre atelier familial crée avec nous depuis 2008.<br\/>Ce lien est vivant : il unit nos mains, nos idées et ce savoir-faire est transmis depuis plus de 30 ans.<\/p>","text_font_size":"body-medium","padding_bottom":16}},"text_HHc9Xe":{"type":"text","settings":{"text":"<h4>Minimaliste, pas simple.<\/h4><p>Maroquinerie pensée à Paris. L’équilibre entre conviction et mouvement.<\/p><p>Libérez votre allure sans l'effort.<\/p>"