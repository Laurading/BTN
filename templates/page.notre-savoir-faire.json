_height":"screen-height-one-third--mobile","reverse_blocks":false,"color_scheme":"","padding_top":0,"padding_bottom":0}},"section_custom_content_adEpQp":{"type":"section-custom-content","blocks":{"text_MDXNY8":{"type":"text","settings":{"subheading":"Le choix des matières","title":"","heading_font_size":"heading-large","text":"<p>Par conviction, Bestini exclut le cuir animal, veau, vache ou agneau, pour explorer une maroquinerie différente. Tes sacs sont fabriqués à partir de matières sélectionnées auprès de fournisseurs capables d'allier technicité et exigence environnementale.<\/p><p>Nos matières principales sont testées en laboratoire, notamment par le CTC, le Centre Technique du Cuir. Cette étape vérifie leur conformité à la réglementation européenne REACH, c'est-à-dire l'absence des substances préoccupantes réglementées. La rigueur ne se négocie pas, parce qu'elle touche à ce que tu portes contre toi chaque jour.<\/p><p>Les doublures sont en matière recyclée, certifiée GRS. Les tissus privilégient des fibres naturelles comme le coton et le lin, choisies pour leur tenue dans le temps, pas pour l'image qu'elles renvoient.<\/p>","text_font_size":"body-medium","button_text":"","button_url":"","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"show_social_links":false,"text_columns":1,"align_text":"text-center","bg_color":"","color":"","heading_tag":"automatic"}},"image_jTX9VW":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Proposition_contenu_instagram_-_Bestini_6.jpg","title":"","heading_font_size":"heading-large","text":"","text_font_size":"body-medium","flex_align":"align--middle-center","show_text_background":false,"bg_color":"","color":"","overlay_type":"disabled","link_text":"","link":"","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"heading_tag":"automatic"}}},"block_order":["text_MDXNY8","image_jTX9VW"],"name":"Custom section","settings":{"borders":false