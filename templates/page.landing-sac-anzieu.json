columns":"flex-align-top","layout_mobile":"1","color_scheme":"","padding_top":50,"padding_bottom":50,"heading_tag":"automatic"}},"section_rich_text_Nq8ryN":{"type":"section-rich-text","blocks":{"heading_6LwAqX":{"type":"heading","settings":{"title":"Pensé pour le rythme de la ville","heading_font_size":"heading-large","padding_bottom":16,"heading_tag":"automatic"}},"text_g7piaG":{"type":"text","settings":{"text":"<p>Dans la cohue des transports ou entre deux rendez-vous, Anzieu protège tes affaires grâce à sa fermeture zippée intégrale qui ne casse jamais la pureté de sa ligne. Et pour éviter ce réflexe de garder ton téléphone constamment à la main, qui te fait scroller machinalement, une poche verticale sécurisée est dissimulée à l'arrière. D'un simple glissement de main le long de ton manteau, tu y accèdes sans même retirer le sac de ton épaule. Tu gardes les mains libres, l'esprit serein et les yeux levés sur la ville.<\/p><p>Du quai du métro jusqu'à la fin de la soirée, Anzieu ne cherche pas à te transformer : il valide ton assurance et rend tes journées plus fluides.<\/p>","text_font_size":"body-medium","padding_bottom":16}},"buttons_3iyT9j":{"type":"buttons","settings":{"button_text":"ANZIEU","button_url":"shopify:\/\/products\/anzieu","button_type":"btn--primary","button_size":"","button_style":"btn--text","show_arrow":true,"padding_bottom":16}}},"block_order":["heading_6LwAqX","text_g7piaG","buttons_3iyT9j"],"name":"Rich text","settings":{"align_text":"text-center","width":"wrapper","color_scheme":"","overlay_type":"disabled","padding_top":100,"padding_bottom":100}},"section_floating_button_tLybtP":{"type":"section-floating-button","name":"Bouton flottant","settings":{"button_text":"JE LE VEUX!","button_url":"shopify:\/\/products\/anzieu","open_new_tab":false,"show_on_mobile":true,"button_type":"btn--primary","button_size":"btn--small","button_style":"btn--solid","show_arrow":false}},"section_product_E8PfKM":{"type":"section-product","name":"Featured product