ottom":50}},"section_multicolumn_876BTJ":{"type":"section-multicolumn","blocks":{"text_n68nCB":{"type":"text","settings":{"column_width":33,"title":"Un compartiment central flottant","heading_font_size":"heading-x-small","text":"<p>Ton ordinateur se glisse à l'arrière en toute sécurité, tandis que l'avant reste souple pour accueillir ta journée. Même rempli, sa structure géométrique reste impeccablement intacte.<\/p>","text_font_size":"body-medium","button_text":"","button_url":"","button_type":"btn--primary","button_style":"btn--solid","show_arrow":false,"heading_tag":"automatic"}},"text_UbwHFY":{"type":"text","settings":{"column_width":33,"title":"Une organisation qui t'apaise","heading_font_size":"heading-x-small","text":"<p>Des poches intérieures bien pensées pour que chaque objet retrouve sa place naturelle, sans que tu aies besoin d'y penser.<\/p>","text_font_size":"body-medium","button_text":"","button_url":"","button_type":"btn--primary","button_style":"btn--solid","show_arrow":false,"heading_tag":"automatic"}},"text_xx7fwr":{"type":"text","settings":{"column_width":33,"title":"Le système de portée modulable","heading_font_size":"heading-x-small","text":"<p>Un jeu de crochets et d'anneaux dissimulés te permet de passer d'un porté épaule ajusté à un porté bandoulière court ou poignet, toujours avec le même équilibre visuel.<\/p>","text_font_size":"body-medium","button_text":"","button_url":"","button_type":"btn--primary","button_style":"btn--solid","show_arrow":false,"heading_tag":"automatic"}}},"block_order":["text_n68nCB","text_UbwHFY","text_xx7fwr"],"disabled":true,"name":"Multi column","settings":{"title":"","heading_font_size":"heading-medium","description":"","align_heading":"text-center","align_text":"text-center","width":"wrapper","align_columns":"flex-align-center","layout_mobile":"1","color_scheme":"","padding_top":0,"padding_bottom":100,"heading_tag":"automatic"}},"section_custom_content_nKpmRV":{"type":"section-custom-content","blocks":{"video_kKr