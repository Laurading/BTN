}
</style>
<script>
(function(){
 if(window.__bestiniMobileCheckout)return;
 window.__bestiniMobileCheckout=true;
 var queued=false;
 function update(){
  queued=false;
  document.querySelectorAll('cart-drawer,[data-cart-page]').forEach(function(scope){
   var drawer=scope.matches('cart-drawer');
   var host=drawer?scope:document.body;
   var kind=drawer?'drawer':'page';
   var bar=host.querySelector(':scope > .bestini-mobile-checkout[data-kind="'+kind+'"]');
   if(!bar){
    bar=document.createElement('div');bar.className='bestini-mobile-checkout';bar.dataset.kind=kind;
    bar.innerHTML='<div class="bestini-mobile-checkout__total"><span>{{ 'cart.general.subtotal' | t | escape }}</span><strong></strong></div><button type="button" class="btn btn--primary btn--solid">{{ 'cart.general.checkout' | t | escape }}</button>';
    bar.querySelector('button').addEventListener('click',function(){
     var original=scope.querySelector('button[name="checkout"]');
     if(original && !original.disabled){original.click();}
    });
    host.appendChild(bar);
   }
   var total=scope.querySelector('[data-cart-price-holder] [data-cart-total]');
   var original=scope.querySelector('button[name="checkout"]');
   var hide=scope.classList.contains('is-empty')||!total||!original;
   if(bar.hidden!==hide)bar.hidden=hide;
   var nativeRect=original && original.getBoundingClientRect();
   var nativeVisible=!!nativeRect && nativeRect.height>0 && nativeRect.top < window.innerHeight-100 && nativeRect.bottom>0;
   var merged=drawer && nativeVisible;
   if(bar.classList.contains('is-merged')!==merged)bar.classList.toggle('is-merged',merged);
   var text=total?total.textContent.trim():'';
   var value=bar.querySelector('strong');if(value.textContent!==text)value.textContent=text;
   var disabled=!original||original.disabled||!!scope.querySelector('.cart__buttons--disabled');
   var button=bar.querySelector('button');if(button.disabled!==disabled)button.disabled=disabled;
  });
 }
 function schedule(){if(!queued){queued=true;requestAnimationFrame(update);}}
 document.addEventListener('scroll',schedule,{capture:true,passive:true});
 window.addEventListener('resize',schedule,{passive:true});
 function init(){
  update();
  document.querySelectorAll('cart-drawer,[data-cart-page]').forEach(function(scope){
   new MutationObserver(function(records){
    if(records.some(function(r){return !r.target.closest || !r.target.closest('.bestini-mobile-checkout');}))schedule();
   }).observe(scope,{childList:true,subtree:true,characterData:true,attributes:true,attributeFilter:['class','disabled','data-cart-total']});
  });
  ['theme:cart:change','theme:cart:refresh','cart-drawer:open'].forEach(function(name){document.addEventListener(name,schedule);});
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init,{once:true});else init();
})();
</script>



