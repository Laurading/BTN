<script id="bestini-upsell-config" type="application/json">
{"variantId":{{ bestini_blindbox_variant.id | json }},"regularPrice":{{ bestini_blindbox_variant.price | json }},"country":{{ localization.country.iso_code | json }},"currency":{{ localization.country.currency.iso_code | json }},"customerLoggedIn":{% if customer %}true{% else %}false{% endif %}}
</script>
<script>
(() => {
  const config = JSON.parse(document.getElementById('bestini-upsell-config').textContent);
  if (window.__bestiniShopifyUpsellPrice) return;
  window.__bestiniShopifyUpsellPrice = true;
  const gid = 'gid://shopify/ProductVariant/' + config.variantId;
  const root = window.Shopify?.routes?.root || '/';
  let timer, busy = false, pending = false, revision = 0, cached = null;
  const query = 'mutation UpsellQuote($input: CartInput) { cartCreate(input: $input) { userErrors { message } warnings { code message } cart { lines(first: 100) { pageInfo { hasNextPage } nodes { quantity merchandise { ... on ProductVariant { id } } cost { subtotalAmount { amount currencyCode } totalAmount { amount currencyCode } } } } } } }';
  function cards() {
    return [...document.querySelectorAll('cart-drawer quick-add-product, [data-section-type="cart"] quick-add-product')]
      .filter(card => card.querySelector('a[href*="/products/blindbox-babi-edition-mantra"]') && String(card.querySelector('input[name="id"]')?.value) === String(config.variantId));
  }
  function paint(result) {
    const currency = result?.currency || config.currency;
    const regular = result?.regular ?? config.regularPrice / 100;
    const amount = result?.amount ?? regular;
    const sale = amount < regular - 0.001;
    const money = new Intl.NumberFormat(document.documentElement.lang || 'fr-FR', { style: 'currency', currency });
    for (const card of cards()) {
      const price = card.querySelector('.product-upsell__price');
      if (!price) continue;
      const signature = [amount, regular, currency, !!result].join(':');
      if (price.dataset.bestiniDynamicPrice !== signature) {
        price.dataset.bestiniDynamicPrice = signature;
        const current = document.createElement('span');
        current.className = 'new-price';
        current.textContent = amount === 0 ? (document.documentElement.lang.startsWith('fr') ? 'Gratuit' : 'Free') : money.format(amount);
        const children = [current];
        if (sale) {
          const old = document.createElement('s');
          old.className = 'old-price';
          old.textContent = money.format(regular);
          children.push(document.createTextNode(' '), old);
        }
        price.replaceChildren(...children);
        price.classList.toggle('sale', sale);
      }
    }
  }
  async function json(url, options = {}) {
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 8000);
    try {
      const response = await fetch(url, { ...options, signal: controller.signal, cache: 'no-store' });
      if (!response.ok) throw new Error('HTTP ' + response.status);
      return await response.json();
    } finally { clearTimeout(timeout); }
  }
  async function update() {
    if (busy) { pending = true; return; }
    if (!cards().length) return;
    busy = true;
    const version = revision;
    try {
      const cart = await json(root + 'cart.js', { headers: { Accept: 'application/json' } });
      // Keep the regular price when an anonymous quote cannot reproduce the cart safely.
      if (config.customerLoggedIn || !cart.items.length || cart.items.length > 40 || cart.items.some(item => item.item_components?.length || Object.keys(item.properties || {}).some(key => !['Couleur', 'Type de vente', 'Livraison estimée'].includes(key)))) {
        if (version === revision) paint(null);
        return;
      }
      const lines = cart.items.map(item => ({ merchandiseId: 'gid://shopify/ProductVariant/' + item.variant_id, quantity: item.quantity, attributes: Object.entries(item.properties || {}).map(([key, value]) => ({ key, value: String(value) })), ...(item.selling_plan_allocation ? { sellingPlanId: 'gid://shopify/SellingPlan/' + item.selling_plan_allocation.selling_plan.id } : {}) }));
      lines.push({ merchandiseId: gid, quantity: 1 });
      const codes = new Set((cart.discount_codes || []).map(code => code.code).filter(Boolean));
      (cart.cart_level_discount_applications || []).filter(discount => discount.type === 'discount_code').forEach(discount => codes.add(discount.title));
      const input = { lines, buyerIdentity: { countryCode: config.country }, discountCodes: [...codes] };
      const signature = JSON.stringify([input, cart.currency, cart.total_price]);
      if (cached?.signature === signature && Date.now() - cached.time < 15000) {
        if (version === revision) paint(cached.result);
        return;
      }
      const response = await json('/api/2026-07/graphql.json', { method: 'POST', credentials: 'omit', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ query, variables: { input } }) });
      const payload = response.data?.cartCreate;
      if (response.errors?.length || !payload?.cart || payload.userErrors?.length || payload.warnings?.length || payload.cart.lines.pageInfo.hasNextPage) throw new Error('Quote unavailable');
      const quoted = payload.cart.lines.nodes.filter(line => line.merchandise.id === gid);
      const expected = 1 + cart.items.filter(item => String(item.variant_id) === String(config.variantId)).reduce((sum, item) => sum + item.quantity, 0);
      if (!quoted.length || quoted.reduce((sum, line) => sum + line.quantity, 0) !== expected || quoted.some(line => line.cost.totalAmount.currencyCode !== cart.currency)) throw new Error('Quote mismatch');
      // Split discounted/full-price lines: do not advertise an already-used offer again.
      const amount = Math.max(...quoted.map(line => Number(line.cost.totalAmount.amount) / line.quantity));
      const regular = Math.max(...quoted.map(line => Number(line.cost.subtotalAmount.amount) / line.quantity));
      if (!Number.isFinite(amount) || !Number.isFinite(regular) || amount < 0) throw new Error('Invalid price');
      const result = { amount, regular, currency: cart.currency };
      cached = { signature, result, time: Date.now() };
      if (version === revision) paint(result);
    } catch (error) {
      cached = null;
      if (version === revision) paint(null);
    } finally {
      busy = false;
      if (pending || version !== revision) { pending = false; schedule(); }
    }
  }
  function schedule() { clearTimeout(timer); timer = setTimeout(update, 180); }
  function changed() { revision++; cached = null; paint(null); schedule(); }
  ['theme:cart:change', 'theme:cart:refresh', 'theme:cart:update', 'theme:cart-drawer:open'].forEach(name => document.addEventListener(name, changed));
  const drawer = document.querySelector('cart-drawer');
  if (drawer) new MutationObserver(records => {
    if (records.some(record => !record.target.closest?.('[data-bestini-dynamic-price], [data-bestini-dynamic-title]'))) schedule();
  }).observe(drawer, { childList: true, subtree: true });
  paint(null);
  schedule();
})();
</script>
