.header__mobile__right .bestini-mobile-language__panel{top:calc(100% + 8px);bottom:auto;right:0;}
.header__mobile__right{gap:0;}
.header__mobile__right .header__mobile__button .navlink{padding-left:6px;padding-right:6px;}
}
</style>
<script>
(function(){
 function placeLanguage(){var language=document.getElementById('BestiniMobileLanguage');var target=document.querySelector('.header__mobile__right');if(language&&target&&language.parentElement!==target)target.prepend(language);}
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',placeLanguage);else placeLanguage();
 document.addEventListener('shopify:section:load',placeLanguage);
})();
</script>
