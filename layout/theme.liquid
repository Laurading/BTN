<!-- Anthony TEST: adaptive mobile product gallery -->
<style>
@media (max-width: 749px) {
  product-images.product__images--mobile-slider [data-product-media-list][data-bestini-adaptive] {
    height: var(--bestini-slide-height);
    min-height: 0;
    align-items: flex-start;
    transition: height 180ms ease;
  }
}
@media (prefers-reduced-motion: reduce) {
  [data-product-media-list][data-bestini-adaptive] { transition: none !important; }
}
</style>
<script>
(() => {
  if (window.__bestiniAdaptiveGallery) return;
  window.__bestiniAdaptiveGallery = true;
  const mobile = window.matchMedia('(max-width: 749px)');
  const instances = new Map();
  const selector = 'product-images.product__images--mobile-slider';
  function mount(gallery) {
    if (instances.has(gallery)) return;
    const list = gallery.querySelector('[data-product-media-list]');
    if (!list) return;
    let frame = 0, timer = 0;
    function update() {
      frame = 0;
      if (!mobile.matches || gallery.hasAttribute('data-fader-mobile')) {
        list.removeAttribute('data-bestini-adaptive');
        list.style.removeProperty('--bestini-slide-height');
        return;
      }
      const bounds = list.getBoundingClientRect();
      if (!bounds.width) return;
      let selected = null, largest = 0;
      for (const slide of list.querySelectorAll('[data-slide]')) {
        const rect = slide.getBoundingClientRect();
        const visible = Math.max(0, Math.min(rect.right, bounds.right) - Math.max(rect.left, bounds.left));
        if (visible > largest && rect.height > 0) { largest = visible; selected = slide; }
      }
      if (!selected) return;
      const height = Math.ceil(selected.getBoundingClientRect().height);
      const value = height + 'px';
      if (height > 0 && list.style.getPropertyValue('--bestini-slide-height') !== value) {
        list.style.setProperty('--bestini-slide-height', value);
      }
      list.setAttribute('data-bestini-adaptive', '');
    }
    function schedule() { if (!frame) frame = requestAnimationFrame(update); }
    function onScroll() { clearTimeout(timer); timer = setTimeout(schedule, 90); }
    const resize = new ResizeObserver(schedule);
    resize.observe(list);
    list.querySelectorAll('[data-slide]').forEach(slide => resize.observe(slide));
    list.addEventListener('scroll', onScroll, {passive: true});
    list.addEventListener('scrollend', schedule);
    list.addEventListener('load', schedule, true);
    gallery.addEventListener('theme:media:select', schedule);
    mobile.addEventListener('change', schedule);
    instances.set(gallery, () => {
      resize.disconnect(); clearTimeout(timer); cancelAnimationFrame(frame);
      list.removeEventListener('scroll', onScroll);
      list.removeEventListener('scrollend', schedule);
      list.removeEventListener('load', schedule, true);
      gallery.removeEventListener('theme:media:select', schedule);
      mobile.removeEventListener('change', schedule);
    });
    schedule();
  }
  function scan() {
    for (const [gallery, dispose] of instances) {
      if (!gallery.isConnected) { dispose(); instances.delete(gallery); }
    }
    document.querySelectorAll(selector).forEach(mount);
  }
  const root = document.getElementById('MainContent');
  if (root) new MutationObserver(scan).observe(root, {childList: true, subtree: true});
  document.addEventListener('shopify:section:load', scan);
  document.addEventListener('theme:product-info:loaded', scan);
  scan();
})();
</script>
