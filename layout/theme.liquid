<script id="bestini-birthday-autofocus">
(function(){
if(window.bestiniBirthdayAutoFocus)return;window.bestiniBirthdayAutoFocus=true;
function fields(el){if(!(el instanceof HTMLInputElement)||!el.id.startsWith('omnisend-form-'))return null;var suffix='-birthdateDay-input',part=0;if(el.id.endsWith('-birthdateMonth-input')){suffix='-birthdateMonth-input';part=1;}else if(el.id.endsWith('-birthdateYear-input')){suffix='-birthdateYear-input';part=2;}else if(!el.id.endsWith(suffix))return null;var base=el.id.slice(0,-suffix.length);return {part:part,list:['Day','Month','Year'].map(function(p){return document.getElementById(base+'-birthdate'+p+'-input');})};}
document.addEventListener('input',function(event){var el=event.target,f=fields(el);if(!f||event.isComposing||event.inputType&&event.inputType.indexOf('delete')===0||document.activeElement!==el)return;var value=el.value;if(f.part<2&&/^\d{2}$/.test(value)&&Number(value)>=1&&Number(value)<=(f.part===0?31:12)){var next=f.list[f.part+1];if(next){next.focus();next.select();}}});
document.addEventListener('keydown',function(event){var f=fields(event.target);if(f&&event.key==='Backspace'&&!event.target.value&&f.part>0){var previous=f.list[f.part-1];if(previous){event.preventDefault();previous.focus();previous.select();}}});
})();
</script>

